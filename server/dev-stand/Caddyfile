# Test copy of the app, built on the server by server/dev-stand/up.sh. /api goes to the stand's API (server/api).
:80 {
	# Separate handle blocks: try_files runs before a bare handle and would turn /api/* into /index.html.
	handle /api/* {
		reverse_proxy api:8789
	}
	handle {
		root * /srv/dist
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
